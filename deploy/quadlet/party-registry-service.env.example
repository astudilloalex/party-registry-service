# Production destination: /home/containers/deployment/env/party-registry-service.env
# GitHub Actions replaces placeholders from production environment secrets.
# Optional production configuration overrides the defaults below.
# Keep the production file readable by the deployment user with permissions 600.

# Runtime: the VPS publishes 127.0.0.1:8082 to this container's port 8080.
QUARKUS_PROFILE=prod
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8080

# PostgreSQL on party-db: confirm the database name and network alias on the VPS.
# Application and Flyway use separate database roles.
DB_USERNAME=party_registry_runtime
DB_PASSWORD=REPLACE_WITH_RUNTIME_DATABASE_PASSWORD
DB_REACTIVE_URL=postgresql://postgresql:5432/party_registry_service
DB_JDBC_URL=jdbc:postgresql://postgresql:5432/party_registry_service
FLYWAY_DB_USERNAME=party_registry_migration
FLYWAY_DB_PASSWORD=REPLACE_WITH_MIGRATION_DATABASE_PASSWORD

# Use the geographic service's internal port on the shared internal-services network.
GEOGRAPHIC_REFERENCE_BASE_URL=http://geographic-reference-service:8080
GEOGRAPHIC_REFERENCE_CONNECT_TIMEOUT_MS=2000
GEOGRAPHIC_REFERENCE_READ_TIMEOUT_MS=5000

# Confirm that the RabbitMQ hostname is reachable from the container's networks.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=REPLACE_WITH_RABBITMQ_USERNAME
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD
RABBITMQ_VIRTUAL_HOST=platform

# Supply four independent, securely generated, Base64-encoded 32-byte keys.
PARTY_IDENTIFIER_ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_ENCRYPTION_KEY
PARTY_IDENTIFIER_CURRENT_ENCRYPTION_KEY_VERSION=1
PARTY_IDENTIFIER_INDEX_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTE_IDENTIFIER_INDEX_HMAC_KEY
PARTY_REGISTRATION_IDEMPOTENCY_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTE_REGISTRATION_HMAC_KEY
PARTY_CURSOR_CURRENT_SIGNING_KEY_ID=v1
PARTY_CURSOR_SIGNING_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_CURSOR_SIGNING_KEY

# Optional query and mutation limits; these values match application defaults.
PARTY_QUERY_STATEMENT_TIMEOUT=5s
PARTY_QUERY_TRAVERSAL_TIMEOUT=15s
PARTY_MUTATION_LOCK_TIMEOUT=5s
PARTY_MUTATION_STATEMENT_TIMEOUT=10s
PARTY_MUTATION_OPERATION_TIMEOUT=15s

# Outbox modes: disabled, stored-only, published. Published requires broker permissions.
PARTY_OUTBOX_MODE=disabled
PARTY_OUTBOX_EXCHANGE=party.events
PARTY_OUTBOX_ROUTING_KEY=party.events
PARTY_OUTBOX_POLL_INTERVAL=5s
PARTY_OUTBOX_BATCH_SIZE=25
PARTY_OUTBOX_PUBLISH_TIMEOUT=5s
PARTY_OUTBOX_CLAIM_LEASE=30s
PARTY_OUTBOX_INITIAL_BACKOFF=1s
PARTY_OUTBOX_MAXIMUM_BACKOFF=5m
PARTY_OUTBOX_MAXIMUM_ATTEMPTS=10

# Optional tracing; none keeps export disabled. Set otlp with a reachable collector.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Enable only when the deployment uses the corresponding authentication challenge.
API_JSON_AUTHENTICATION_CHALLENGE_ENABLED=false
