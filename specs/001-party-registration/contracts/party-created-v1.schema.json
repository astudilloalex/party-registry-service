{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alexastudillo:party-registry:event:party-created:v1",
  "title": "Party Created Event Payload V1",
  "description": "Recording payload for party.created.v1. Outbox metadata carries tenant, aggregate identity, version and occurrence time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partyType"
  ],
  "properties": {
    "partyType": {
      "type": "string",
      "enum": [
        "NATURAL_PERSON",
        "LEGAL_ENTITY"
      ]
    }
  },
  "examples": [
    {
      "partyType": "NATURAL_PERSON"
    },
    {
      "partyType": "LEGAL_ENTITY"
    }
  ]
}
