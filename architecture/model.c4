specification {
  element person
  element softwareSystem
  element container
  element component

  deploymentNode environment
  deploymentNode host
  deploymentNode boundary
  deploymentNode reverse_proxy
  deploymentNode runtime
  deploymentNode secret_injection
}

model {
  internalConsumer = person 'Internal Service Consumer' {
    description 'Submits trusted tenant-scoped Party Registry commands and queries.'
  }

  eventConsumer = softwareSystem 'Event Consumer' {
    description 'Consumes versioned Party Registry events and deduplicates by event ID.'
  }

  geographicReference = softwareSystem 'Geographic Reference Service' {
    description 'Owns active ISO 3166-1 alpha-2 country reference data.'
  }

  rabbitMq = softwareSystem 'RabbitMQ' {
    description 'Accepts persistent Party Registry events with publisher confirms; consumer queues and DLQs are externally owned.'
  }

  partyRegistry = softwareSystem 'Party Registry Service' {
    description 'Tenant-scoped system of record for civil and legal identity, protected official identifiers and approved business events.'

    application = container 'Party Registry Application' {
      technology 'Java 25, Quarkus, reactive execution'
      description 'Provides the internal reactive REST API, orchestrates Party and Identifier use cases, reads the database-managed Identifier Scheme catalog, and publishes committed outbox events.'

      reactiveApi = component 'Reactive REST Adapter' {
        description 'Validates transport and trusted request context, maps Party and Identifier commands/results, ETags and stable response envelopes. It exposes no Identifier Scheme administration API.'
      }
      partyInputPorts = component 'Party Input Ports (Application-owned)' {
        description 'Declares boundary-neutral Party, detail and nationality commands and queries owned by the Application layer.'
      }
      identifierInputPorts = component 'Identifier Input Ports (Application-owned)' {
        description 'Declares boundary-neutral Party Identifier lifecycle, exact-search and decryption use cases owned by the Application layer.'
      }
      partyCapability = component 'Party Application Capability' {
        description 'Application layer: orchestrates Party, detail and nationality use cases, pre-transaction country resolution, transaction intent and aggregate consistency.'
      }
      identifierCapability = component 'Identifier Application Capability' {
        description 'Application layer: orchestrates protected identifier lifecycle, reads database-managed scheme metadata, enforces permanent tenant-and-scheme identifier uniqueness, exact lookup and fail-closed decryption.'
      }
      partyDomain = component 'Party Registry Domain' {
        description 'Framework-independent domain entities, value objects, invariants, lifecycle policies, masking rules and domain errors.'
      }
      partyPersistencePorts = component 'Party Persistence and Unit-of-Work Ports (Application-owned)' {
        description 'Application-owned output contracts for tenant-qualified Party persistence and atomic mutation plus required outbox insertion.'
      }
      identifierPersistencePorts = component 'Identifier and Scheme Catalog Ports (Application-owned)' {
        description 'Application-owned output contracts for tenant-qualified Identifier persistence and query-only database-managed Scheme catalog access.'
      }
      geographicReferencePort = component 'Geographic Reference Port (Application-owned)' {
        description 'Application-owned output contract returning country evidence or explicit unavailability before a state-changing transaction begins.'
      }
      identifierProtectionPort = component 'Identifier Protection Port (Application-owned)' {
        description 'Application-owned output contract for authenticated encryption/decryption, tenant-effective HMAC and protected key-version outcomes.'
      }
      securityLogPort = component 'Decryption Security Log Port (Application-owned)' {
        description 'Application-owned output contract requiring successful local non-plaintext security-log emission before plaintext disclosure.'
      }
      outboxStorePort = component 'Outbox Store Port (Application-owned)' {
        description 'Application-owned output contract for bounded committed claims and separate optimistic delivery-outcome transactions.'
      }
      eventPublisherPort = component 'Event Publisher Port (Application-owned)' {
        description 'Application-owned output contract for persistent publication and classified publisher-confirm outcomes.'
      }
      clockPort = component 'Clock Port (Application-owned)' {
        description 'Application-owned output contract for testable current time without scheduling or framework dependencies.'
      }
      eventPublication = component 'Outbox Publication Capability' {
        description 'Application layer: commits bounded claim reservations before broker I/O, publishes without database locks, and records confirmation outcomes in separate transactions while preserving same-event recovery semantics.'
      }
      postgresAdapter = component 'PostgreSQL Adapter' {
        description 'Implements tenant-scoped persistence, permanent identifier uniqueness, DBML-governed local transactions, and read-only runtime access to identifier_schemes.'
      }
      geographicAdapter = component 'Geographic Reference Adapter' {
        description 'Validates active country codes through a bounded non-durable cache and reactive provider client.'
      }
      protectionAdapter = component 'Identifier Protection Adapter' {
        description 'Implements authenticated encryption, tenant-effective HMAC and versioned runtime-secret resolution without a network key-service dependency.'
      }
      rabbitAdapter = component 'RabbitMQ Publisher Adapter' {
        description 'Publishes persistent versioned events and classifies publisher-confirm outcomes.'
      }
      securityLogAdapter = component 'Decryption Security Log Adapter' {
        description 'Emits the mandatory non-plaintext structured security log through the local application logging path and reports successful emission before plaintext return.'
      }
      systemClockAdapter = component 'System Clock Adapter' {
        description 'Implements testable current-time access at the infrastructure boundary.'
      }
      runtimeComposition = component 'Runtime Composition and Readiness' {
        description 'Bootstrap boundary: selects and wires concrete adapters to core-owned ports, validates required database-managed scheme/rule compatibility, and registers health and telemetry.'
      }
    }

    database = container 'Party Registry PostgreSQL Database' {
      technology 'PostgreSQL 18 contract target'
      description 'Stores DBML-governed Party Registry state, the database-managed Identifier Scheme reference catalog, transactional outbox state, and permanent tenant-and-scheme identifier uniqueness.'
    }
  }

  internalConsumer -> partyRegistry 'Submits trusted tenant-scoped V1 Party and Identifier commands and queries using the internal reactive REST contract.'
  partyRegistry -> geographicReference 'Validates new active country references through the approved bounded cache policy.'
  partyRegistry -> rabbitMq 'Publishes persistent committed business events with publisher confirms and stable event IDs.'
  rabbitMq -> eventConsumer 'Delivers Party Registry events at least once to consumer-owned queues.'

  internalConsumer -> partyRegistry.application 'Submits V1 HTTPS/JSON Party and Identifier commands and queries with tenant, user and process context.'
  partyRegistry.application -> partyRegistry.database 'Stores and queries DBML-governed state and reads database-managed Identifier Scheme metadata.'
  partyRegistry.application -> geographicReference 'Retrieves active country-reference evidence through a reactive bounded-cache adapter.'
  partyRegistry.application -> rabbitMq 'Publishes committed versioned outbox events using persistent messages and confirms.'

  partyRegistry.application.reactiveApi -> partyRegistry.application.partyInputPorts 'Depends inward on and invokes Application-owned Party input contracts.'
  partyRegistry.application.reactiveApi -> partyRegistry.application.identifierInputPorts 'Depends inward on and invokes Application-owned Identifier input contracts.'
  partyRegistry.application.partyInputPorts -> partyRegistry.application.partyCapability 'Dispatches boundary-neutral requests to the implementing Party use cases.'
  partyRegistry.application.identifierInputPorts -> partyRegistry.application.identifierCapability 'Dispatches boundary-neutral requests to the implementing Identifier use cases.'
  partyRegistry.application.partyCapability -> partyRegistry.application.partyDomain 'Applies framework-independent Party domain policies and invariants.'
  partyRegistry.application.identifierCapability -> partyRegistry.application.partyDomain 'Applies framework-independent Identifier domain policies and invariants.'
  partyRegistry.application.partyCapability -> partyRegistry.application.partyPersistencePorts 'Invokes tenant-qualified persistence and atomic unit-of-work output contracts.'
  partyRegistry.application.partyCapability -> partyRegistry.application.geographicReferencePort 'Resolves required country evidence before opening a state-changing PostgreSQL transaction.'
  partyRegistry.application.identifierCapability -> partyRegistry.application.identifierPersistencePorts 'Invokes Identifier persistence and query-only Scheme catalog output contracts.'
  partyRegistry.application.identifierCapability -> partyRegistry.application.identifierProtectionPort 'Invokes protected-value and fingerprint output contracts.'
  partyRegistry.application.identifierCapability -> partyRegistry.application.securityLogPort 'Requires successful local security-log emission before plaintext disclosure.'
  partyRegistry.application.partyCapability -> partyRegistry.application.clockPort 'Obtains current time for approved validation and audit semantics.'
  partyRegistry.application.identifierCapability -> partyRegistry.application.clockPort 'Obtains current time for approved validation, lifecycle and audit semantics.'
  partyRegistry.application.eventPublication -> partyRegistry.application.outboxStorePort 'Invokes bounded claim and separate outcome transaction contracts.'
  partyRegistry.application.eventPublication -> partyRegistry.application.eventPublisherPort 'Invokes persistent publication and publisher-confirm contracts only after claim commit.'
  partyRegistry.application.postgresAdapter -> partyRegistry.application.partyPersistencePorts 'Implements Application-owned Party persistence and atomic unit-of-work contracts.'
  partyRegistry.application.postgresAdapter -> partyRegistry.application.identifierPersistencePorts 'Implements Application-owned Identifier persistence and query-only Scheme catalog contracts.'
  partyRegistry.application.postgresAdapter -> partyRegistry.application.outboxStorePort 'Implements Application-owned short claim and separate outcome transaction contracts.'
  partyRegistry.application.geographicAdapter -> partyRegistry.application.geographicReferencePort 'Implements the Application-owned country-reference contract without exposing provider models inward.'
  partyRegistry.application.protectionAdapter -> partyRegistry.application.identifierProtectionPort 'Implements the Application-owned identifier protection contract without provider leakage.'
  partyRegistry.application.securityLogAdapter -> partyRegistry.application.securityLogPort 'Implements the Application-owned local decryption security-log contract.'
  partyRegistry.application.rabbitAdapter -> partyRegistry.application.eventPublisherPort 'Implements the Application-owned publisher-confirm contract.'
  partyRegistry.application.systemClockAdapter -> partyRegistry.application.clockPort 'Implements the Application-owned current-time contract.'
  partyRegistry.application.postgresAdapter -> partyRegistry.database 'Executes DBML-governed reactive queries, uniqueness constraints and local transactions; runtime writes to identifier_schemes are forbidden.'
  partyRegistry.application.geographicAdapter -> geographicReference 'Retrieves active ISO country references.'
  partyRegistry.application.rabbitAdapter -> rabbitMq 'Publishes persistent messages to the approved durable topic exchange.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.reactiveApi 'Composes the inbound adapter with Application-owned input ports.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.postgresAdapter 'Binds persistence output ports to the PostgreSQL adapter.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.geographicAdapter 'Binds the country-reference output port to its adapter.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.protectionAdapter 'Binds identifier protection to runtime-secret-backed infrastructure.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.securityLogAdapter 'Binds fail-closed decryption logging to the local logging adapter.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.rabbitAdapter 'Binds event publication to the RabbitMQ adapter.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.systemClockAdapter 'Binds current-time access to the infrastructure clock adapter.'
  partyRegistry.application.runtimeComposition -> partyRegistry.application.eventPublication 'Starts the bounded Application-layer outbox publication capability and exposes lag/failure signals.'
}

deployment {
  environment productionBoundary 'Production Environment' {
    host vpsHost 'Approved VPS Host' {
      reverse_proxy reverseProxy 'Internal nginx Boundary' {
        description 'Routes approved internal traffic; Party Registry is not publicly bound.'
      }

      runtime rootlessPodman 'Rootless Podman and Quadlet' {
        applicationInstance = instanceOf partyRegistry.application

        secret_injection runtimeSecrets 'Protected Runtime Secret Injection' {
          description 'Injects versioned encryption and HMAC master keys from approved runtime mechanisms. Local/development may use an unversioned .env file; VPS runtime may use Podman secrets or a protected host-only env file. Secret values never enter Git, the OCI image, logs, traces or metrics.'
        }
      }
    }

    boundary operationsDependencies 'Operations-managed Dependency Boundary' {
      databaseInstance = instanceOf partyRegistry.database
      messageBroker = instanceOf rabbitMq
    }

    boundary externalServices 'Internal External-service Boundary' {
      geography = instanceOf geographicReference
    }
  }
}

views {
  view systemContext of partyRegistry {
    title 'Party Registry Service — System Context'
    description 'People, target system and actual external systems only. Identifier Scheme maintenance is database governance, not a Party Registry actor interaction.'
    include internalConsumer
    include partyRegistry
    include geographicReference
    include rabbitMq
    include eventConsumer
  }

  view containers of partyRegistry {
    title 'Party Registry Service — Containers'
    description 'One application deployable and its service-owned PostgreSQL data container; Identifier Schemes are database-managed reference data read by the application.'
    include internalConsumer
    include partyRegistry.application
    include partyRegistry.database
    include geographicReference
    include rabbitMq
    include eventConsumer
  }

  view applicationComponents of partyRegistry.application {
    title 'Party Registry Application — Components'
    description 'Strict Clean Architecture with Party and Identifier use cases only; no Scheme Administration capability.'
    include *
  }

  deployment view productionDeployment {
    title 'Party Registry Service — Logical Production Deployment'
    description 'Rootless Podman/Quadlet on the approved VPS with runtime secret injection and actual operations-managed dependency boundaries; physical dependency placement remains operations-owned.'
    include productionBoundary.**
  }
}
